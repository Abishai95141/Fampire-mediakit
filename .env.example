# Copy to .env — `npm run setup` does it for you and generates the secret.
#
#     cp .env.example .env
#
# Only the first three matter on a laptop. Everything below them is deployment
# configuration with a working default or an off switch.

# ─── Required ────────────────────────────────────────────────────────────

# Where this instance answers. Used for canonical URLs, the sitemap and
# absolute links in metadata — not for binding the port (that is `-p 3200`).
SITE_URL=http://localhost:3200

# Postgres. Holds ~600 catalog entries and the page content, and NEVER the
# client's media: those files stay in their own Drive, Dropbox, Pic-Time and
# Vimeo, and this database only ever stores a link and a description.
#
# This default matches docker-compose.yml, so `docker compose up -d` and this
# line agree with no edit. Using a Postgres you already run? Replace it, e.g.
#   postgres://localhost:5432/fampire_media_center
DATABASE_URI=postgres://fampire:fampire@localhost:5433/fampire_media_center

# Signs admin sessions. `npm run setup` generates one; to make your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing admin session. Never commit a real one.
PAYLOAD_SECRET=

# ─── Optional: only when this runs somewhere other than a laptop ─────────
# Both are ignored locally. Neither needs setting to develop.

# Managed Postgres refuses unencrypted connections; a local one has no TLS at
# all. Declared here rather than guessed from the hostname.
# DATABASE_SSL=true

# Uploads. Unset — the default — writes them to disk under public/, which is
# right on a laptop and silently destructive on a container with an ephemeral
# filesystem. Name any S3-compatible bucket and the storage adapter takes over.
# Credentials are NOT read from here: the host supplies them through its own
# instance role, so nothing long-lived ends up in a file.
# S3_BUCKET=
# AWS_REGION=          # the storage SDK's own variable name, whoever hosts it

# ─── Optional: first admin account ───────────────────────────────────────
# Read by `npm run setup` only. Leave them out and it will ask you instead,
# which is the better habit — a password in a file is a password on disk.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
