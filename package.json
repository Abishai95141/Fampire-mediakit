{
  "name": "fampire-media-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "verify": "node scripts/verify.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:cms": "payload run scripts/verify-cms.ts",
    "verify:search": "payload run scripts/verify-search.ts",
    "verify:catalog": "payload run scripts/verify-catalog.ts",
    "verify:magazines": "payload run scripts/verify-magazine-tree.ts",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:admin": "payload run scripts/create-admin.ts",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "catalog:build": "node scripts/enrich/build-entries.mjs",
    "catalog:import": "payload run scripts/import-entries.ts",
    "links:check": "payload run scripts/check-links.ts",
    "fampire:previews": "node scripts/fampire/build-previews.mjs",
    "fampire:appearances": "node scripts/fampire/build-appearances.mjs",
    "fampire:catalog": "node scripts/fampire/build-catalog.mjs",
    "fampire:links": "node scripts/fampire/check-links.mjs",
    "orientation:sample": "node scripts/enrich/sample-orientation.mjs",
    "dev:hnn": "npm --prefix \"${HNN_DIR:-$HOME/HNN}\" run dev",
    "dev:all": "concurrently -n fampire,hnn -c cyan,magenta \"npm run dev\" \"npm run dev:hnn\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "framer-motion": "^12.42.2",
    "graphql": "^16.14.2",
    "lenis": "^1.3.25",
    "next": "16.2.10",
    "payload": "^3.88.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@esbuild/linux-arm64": "0.25.12",
    "@esbuild/linux-x64": "0.25.12",
    "@unrs/resolver-binding-linux-arm64-gnu": "1.12.2",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2"
  }
}
