# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# embedded database (PGlite) — recreate with npm run db:setup
# `/data/*` rather than `/data`: git cannot re-include anything beneath an
# excluded DIRECTORY, so ignoring the children instead of the folder is what
# lets the negations below work at all.
/data/*
# …except the small manifests the app imports at build time. Without these a
# clean clone fails to compile, so they are source, not generated artifacts.
!/data/asset-thumbs.json
# The FAMPIRE catalog is source too: lib/fampire/catalog.ts imports it at build
# time, and data/fampire/sources/ is the captured provenance the generators in
# scripts/fampire/ read. None of it is database state.
!/data/fampire/


# asset library — relocated to STORAGE_DIR (see docs/assets-storage.md)
/public/portal-assets
/public/portal-packs
/public/brand-assets
.figma-cache/

# CMS walkthrough recorder output — regenerated by scripts/cms-walkthrough.mjs
docs/cms-walkthrough/output/

# The hero's default video — a self-hosted copy of the client's own trailer,
# kept out of git because it's a 57MB binary. Deployed by rsyncing it onto
# the box directly; see lib/fampire/media.ts for provenance/how to redo it.
/public/hero/
